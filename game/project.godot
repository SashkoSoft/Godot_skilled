; Вертикальный срез: бродилка по домам, изометрия.
config_version=5

[application]
config/name="Overgrown (срез)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.06, 0.07, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
; 8x MSAA — кромки стен и переплётов на изометрии видно в упор
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=0
; текстура пола уходит под скользящим углом: без анизотропии она мылится в шум
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/texture_mipmap_bias=-0.25
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
