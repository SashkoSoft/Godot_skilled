shader_type spatial;
render_mode cull_back, diffuse_burley;

// Покрытие улицы: тротуарная плита, асфальт, земля. Рисунок считается от
// МИРОВОЙ точки, а не берётся тайловой картинкой — на полосе длиной в сотни
// метров любой тайл рано или поздно начинает дышать сеткой, и никакой размер
// плитки этого не лечит. Здесь повтора нет ни на каком масштабе.
//
// `kind`: 0 — плита, 1 — асфальт, 2 — земля.
uniform int kind = 0;

uniform vec3 col_a : source_color = vec3(0.62, 0.61, 0.58);
uniform vec3 col_b : source_color = vec3(0.44, 0.43, 0.41);
uniform vec3 col_joint : source_color = vec3(0.24, 0.24, 0.22);
uniform float plate = 0.75;
uniform float joint = 0.030;
uniform float rough_base = 0.92;

// Поперечная привязка полосы. Улица идёт вдоль X, значит «поперёк» — это Z.
// lat = 0 по оси полосы, ±1 у кромок. Без этой оси покрытие остаётся ровным
// серым полем: ни колеи, ни осевая разметка, ни намыв у бордюра не знают,
// где у полосы середина. У каждой полосы своя копия материала — общий
// материал означал бы один lat_center на всех.
uniform float lat_center = 0.0;
uniform float lat_half = 1.0;

// Разметка: 0 — нет, 1 — осевой пунктир.
uniform int marking = 0;
// Глубина микрорельефа в метрах. 0 — плоско, как крашеный картон.
uniform float bump = 1.0;
// Отладка: 0 — как есть, 1 — мировая нормаль цветом, 2 — поле высот.
uniform int debug = 0;

// Хеш без `sin`. Это полноэкранные плоскости, на каждый пиксель приходятся
// десятки выборок шума, и тригонометрия в каждой — самое дорогое, что тут
// может быть.
float h21(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = h21(i);
	float b = h21(i + vec2(1.0, 0.0));
	float c = h21(i + vec2(0.0, 1.0));
	float d = h21(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p, int oct) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 6; i++) {
		if (i >= oct) break;
		s += a * vnoise(p);
		p *= 2.03;
		a *= 0.5;
	}
	return s;
}

// Затухание полосы частот по размеру пикселя в МИРОВЫХ единицах. У
// процедурной текстуры нет мип-уровней, и как только период шума становится
// меньше пары пикселей, он перестаёт быть фактурой и превращается в шахматку
// из отдельных точек — ровно тот же муар, что и от тайла, только мельче.
// `texel` — сколько метров приходится на пиксель здесь и сейчас.
float band(float freq, float texel) {
	return clamp(1.0 - texel * freq * 1.6, 0.0, 1.0);
}

// Хребтовый шум: даёт ВЕТВЯЩИЕСЯ тонкие линии. Обычный fbm с порогом по
// |n−0.5| рисует одну мажущую полосу на октаву, и асфальт от неё выглядит
// заляпанным, а не потрескавшимся.
float ridge(vec2 p, int oct) {
	float s = 0.0;
	float a = 0.5;
	for (int i = 0; i < 6; i++) {
		if (i >= oct) break;
		float n = 1.0 - abs(vnoise(p) * 2.0 - 1.0);
		s += a * n * n;
		p = p * 2.11 + 7.3;
		a *= 0.5;
	}
	return s;
}

void fragment() {
	vec3 wpos = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 w = wpos.xz;

	// Боковые грани — торец бордюра или обрез покрытия, им ни колеи, ни
	// разметка не нужны. Ранним `return` это не отсечь: в Godot `return` во
	// фрагментной функции запрещён, поэтому флаг и подмена в конце.
	//
	// Сравнивать надо МИРОВУЮ вертикаль. `NORMAL` во фрагменте Godot — видовая,
	// и у горизонтального пола её `y` падает вместе с наклоном камеры: на
	// взгляде сверху (−84°) он равен 0.1, и всё покрытие уходило в ветку
	// торца — сверху дорога превращалась в ровные серые ленты.
	vec3 n_world = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	bool is_side = abs(n_world.y) < 0.5 && kind != 2;

	float lat = clamp((w.y - lat_center) / max(lat_half, 0.001), -1.0, 1.0);
	float edge = abs(lat);

	// Высокие частоты глушатся с расстоянием: иначе на дальнем плане зерно
	// превращается в муар, то есть в ту же сетку, от которой мы уходили.
	float dist = length(VERTEX);
	// Среднее геометрическое, а не максимум: под скользящим углом пиксельный
	// след сильно вытянут, и по максимуму гасится вся фактура разом — плита в
	// двух метрах от камеры остаётся гладким мылом. Аппаратная анизотропия
	// ровно этим и занимается; для процедурной текстуры приходится вручную.
	float texel = sqrt(max(fwidth(w.x) * fwidth(w.y), 1e-12));
	// Поворот домена для мелких слоёв: у value-шума экстремумы сидят на узлах
	// решётки, и выборка по осям мира даёт мозаику из квадратных пятнышек,
	// выровненных по X и Z, вместо фактуры.
	mat2 rot = mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8));
	float mid_fade = clamp(1.0 - dist / 140.0, 0.0, 1.0);

	// Три поля шума на всё покрытие, дальше они ПЕРЕИСПОЛЬЗУЮТСЯ: каждый
	// лишний fbm — четыре выборки на октаву на каждом пикселе экрана.
	float stain = fbm(w * 0.055, 3);
	float mid = fbm(w * 0.9, 2);
	float grain = fbm(w * 11.0, 2);

	float t = clamp(stain * 0.85 + mid * 0.25 - 0.12, 0.0, 1.0);
	vec3 col = mix(col_b, col_a, t);
	col *= 1.0 - (grain - 0.5) * 0.20 * band(11.0, texel);

	float rough = rough_base;
	// Рельеф в метрах, накапливается вместе с цветом: то, что темнее из-за
	// углубления, должно быть углублением и по нормали.
	float hgt = (grain - 0.5) * 0.002;

	if (kind == 0) {
		// --- тротуарная плита ----------------------------------------------
		// Перевязка: каждый второй ряд сдвинут на полплиты. Прямая сетка
		// «клетка в клетку» сразу читается фальшивкой, так плитку не кладут.
		float row = floor(w.y / plate);
		float shift = mod(row, 2.0) * 0.5;
		vec2 cell = vec2(w.x / plate + shift, w.y / plate);
		vec2 id = floor(cell);
		vec2 f = fract(cell);

		float r1 = h21(id);
		float r2 = h21(id + 19.7);
		// Разброс тона от плиты к плите — то, что отличает уложенный двор от
		// одной большой серой поверхности с сеткой поверх. Плиты лили разными
		// замесами и в разные годы.
		col *= 1.0 + (r1 - 0.5) * 0.24;
		col *= 1.0 + (vnoise(w * 2.7 + id * 7.3) - 0.5) * 0.14;
		// Разводы поверх раскладки — переиспользуем уже посчитанное поле.
		// Без них плиты одного замеса выглядят покрашенными из одного ведра.
		col *= 0.90 + mid * 0.22;

		// Ширина шва гуляет: где-то плиты разошлись, где-то встык. Модуляция
		// шума слабая намеренно: при сильной шов рассыпается в пунктир, и
		// тротуар выглядит прошитым на машинке.
		float jw = joint * (0.7 + 0.9 * h21(id + 5.1));
		vec2 e = min(f, 1.0 - f) * plate;
		float dmin = min(e.x, e.y);
		// Ширина перехода не меньше пикселя на экране, иначе шов тоньше
		// растра и рассыпается в пунктир из отдельных тёмных точек.
		float fw = fwidth(dmin) * 1.5;
		float seam = 1.0 - smoothstep(jw * 0.35 - fw, jw * 1.1 + fw, dmin);
		seam *= 0.80 + 0.20 * vnoise(w * 6.0);

		// Грязь копится у кромок полосы: у бордюра и у стены её больше всего,
		// по середине ходят и вытирают.
		float dirt = smoothstep(0.45, 1.0, edge) * 0.55 + stain * 0.35;
		col *= 1.0 - dirt * 0.32;
		col = mix(col, col_joint * (1.0 - dirt * 0.25),
				seam * (0.70 + dirt * 0.30));
		rough = mix(rough, 1.0, seam);

		// Рельеф плиты — это ФАСКА по краю, а не общая просадка к шву. Широкая
		// мягкая ямка вокруг всего периметра превращает плиту в надутую
		// подушку: при скользящем свете каждая начинает блестеть по центру.
		// Реальная плита плоская, у неё снята кромка 2–3 см.
		float cham = 1.0 - smoothstep(0.0, 0.030, dmin);
		hgt -= cham * 0.005 + seam * 0.004;

		// Плиты просели и перекосились. Перекос слабый: на 0.75 м плиты
		// разница краёв в 5 мм уже читается, больше — превращает тротуар в
		// волну.
		float sunk = smoothstep(0.62, 1.0, r2);
		col *= 1.0 - sunk * 0.14;
		hgt -= sunk * 0.008;
		hgt += ((f.x - 0.5) * (r1 - 0.5) + (f.y - 0.5) * (r2 - 0.5))
				* plate * 0.010;

		if (r1 > 0.72) {
			// Трещина через плиту, своя у каждой. Тонкая, рваная и не доходит
			// до краёв: ровная жирная линия от шва до шва читается нарисованным
			// червяком, а не расколом.
			float cr = abs(f.x - (0.25 + 0.5 * r2)
					+ (vnoise(w * 9.0 + id) - 0.5) * 0.20
					+ (vnoise(w * 33.0) - 0.5) * 0.045);
			float cm = 1.0 - smoothstep(0.004, 0.016, cr);
			cm *= smoothstep(0.04, 0.30, f.y) * smoothstep(0.04, 0.30, 1.0 - f.y);
			col = mix(col, col_joint, cm * 0.55);
			rough = mix(rough, 1.0, cm);
			// Мелко: у глубокой борозды кромка ловит свет и трещина читается
			// белым червяком, то есть ровно тем, от чего уходили.
			hgt -= cm * 0.003;
		}
	} else if (kind == 1) {
		// --- асфальт ---------------------------------------------------------
		// щебень — одна выборка, не fbm: на таком масштабе октавы неразличимы
		float chips = vnoise(w * 26.0);
		col *= 1.0 - (chips - 0.5) * 0.34 * band(26.0, texel);
		hgt += (chips - 0.5) * 0.005 * band(26.0, texel);

		// Колеи: две накатанные полосы. Там асфальт заглажен и темнее, между
		// ними и по краям — шершавее и светлее.
		float track = exp(-pow((edge - 0.46) / 0.15, 2.0));
		col *= 1.0 - track * 0.13;
		rough = mix(rough, 0.62, track * mid_fade);
		hgt -= track * 0.012;

		// Ремонтные карты: прямоугольные заплаты другого замеса, со швом.
		vec2 pid = floor(vec2(w.x / 7.0, w.y / 3.5) + 31.0);
		if (h21(pid) > 0.68) {
			vec2 pf = fract(vec2(w.x / 7.0, w.y / 3.5) + 31.0);
			vec2 pe = min(pf, 1.0 - pf);
			float pd = min(pe.x, pe.y);
			float pw = fwidth(pd) * 0.8;
			float inside = smoothstep(0.03, 0.07, pd);
			col = mix(col, col * 0.74, inside);
			// Шов заплаты — такая же тонкая линия, как шов плиты, и так же
			// рассыпается в пунктир без запаса на пиксель.
			float pseam = (1.0 - smoothstep(0.008 - pw, 0.035 + pw, pd))
					* smoothstep(0.0, 0.010 + pw, pd);
			col = mix(col, col_joint, pseam * 0.6);
			hgt += inside * 0.006 - pseam * 0.010;
		}

		// Сетка трещин. Один хребтовый шум на три октавы даёт и крупные
		// разломы, и мелкое ветвление; по краям, где нет нагрузки, сетка
		// гуще — это «крокодилья кожа» настоящего старого асфальта.
		// Пороги подняты, а затемнение ослаблено: трещина в асфальте — это
		// тонкий тёмный волос, а не жирная чёрная линия. Жирная читается как
		// нарисованная поверх, и вся полоса выглядит заляпанной.
		float big = ridge(w * 0.55, 3);
		float cm1 = smoothstep(0.70, 0.86, big);
		float cm2 = smoothstep(0.80, 0.94, big) * smoothstep(0.35, 0.9, edge);
		float cm = clamp(cm1 + cm2 * 0.7, 0.0, 1.0);
		col = mix(col, col_b * 0.55, cm * 0.65);
		rough = mix(rough, 1.0, cm);
		hgt -= cm * 0.010;

		// Выбоины: редкие, с тёмным нутром и светлым обломанным ободком.
		vec2 hid = floor(w / 4.5 + 61.0);
		vec2 hf = fract(w / 4.5 + 61.0) - 0.5;
		float hr = h21(hid);
		if (hr > 0.86) {
			float rad = 0.10 + 0.10 * h21(hid + 2.3);
			float d2 = length(hf * vec2(1.0, 1.25))
					+ (vnoise(w * 7.0) - 0.5) * 0.05;
			float hole = 1.0 - smoothstep(rad * 0.6, rad, d2);
			float rim = smoothstep(rad, rad * 1.25, d2)
					* (1.0 - smoothstep(rad * 1.25, rad * 1.6, d2));
			col = mix(col, col_joint * 0.6, hole * 0.85);
			col = mix(col, col_a * 0.9, rim * 0.35);
			rough = mix(rough, 1.0, hole);
			hgt -= hole * 0.045;
			hgt += rim * 0.010;
		}

		// Осевая разметка: почти стёрта. Она и делает полосу дорогой, а её
		// состояние — заброшенной дорогой.
		if (marking == 1) {
			float dash = step(0.35, fract(w.x / 6.0));
			float line = (1.0 - smoothstep(0.045, 0.075,
					abs(lat * lat_half))) * dash;
			float wear = smoothstep(0.30, 0.72, stain * 0.6 + mid * 0.4);
			col = mix(col, vec3(0.72, 0.70, 0.63), line * wear * 0.55);
			rough = mix(rough, 0.80, line * wear);
		}

		// У бордюра наметает песок и мусор, там же держится вода.
		float silt = smoothstep(0.72, 1.0, edge);
		col = mix(col, col_a * 0.78, silt * (0.30 + 0.30 * mid));
		rough = mix(rough, 1.0, silt);
		hgt += silt * 0.005;
	} else {
		// --- земля -----------------------------------------------------------
		// Комковатость двух масштабов: крупные бугры и мелкая структура.
		float lumps = fbm(w * 3.1, 3);
		col *= 0.85 + lumps * 0.35;
		hgt += lumps * 0.012;
		// Проплешины вытоптанного грунта в траве и наоборот.
		float bare = smoothstep(0.42, 0.66, stain);
		col = mix(col, col_a * 1.05, bare * 0.35);
		rough = mix(rough, 1.0, bare);

		// Обочина: полоса у самой кромки тротуара вытоптана и засыпана
		// высыпавшимся щебнем. Без неё плита встречается с землёй по линейке,
		// и обе выглядят приклеенными друг к другу.
		// Контраст щебня гаснет с расстоянием: на дальнем плане мелкая крупа
		// превращается в мерцающую сыпь, то есть в тот же муар.
		// Контраст щебня заметно ниже, чем хочется «по смыслу»: полоса идёт
		// вдоль всего кадра, и любой яркий мелкий разброс на ней читается не
		// обочиной, а белой сыпью по краю дороги — самым искусственным пятном
		// в кадре. Плюс затухание по пикселю, иначе вдали она мерцает.
		float shoulder = smoothstep(0.988, 1.0, edge);
		float b_gr = band(18.0, texel);
		float gr = vnoise(rot * w * 18.0);
		col = mix(col, col * (1.10 + (gr - 0.5) * 0.22 * b_gr), shoulder);
		hgt += (gr - 0.5) * 0.004 * shoulder * b_gr;
		rough = mix(rough, 1.0, shoulder);
	}

	// Ближняя фактура. Без неё любое покрытие на расстоянии вытянутой руки
	// превращается в гладкое мыло: поля шума на 9 см и крупнее с двух метров
	// уже не видны, а поры, раковины и зерно — видны. Включается только
	// вблизи: на 120 выборках на метр всё, что дальше десятка метров, — муар.
	// Две октавы, а не одна: поворот убирает совпадение с осями, вторая
	// октава — совпадение с решёткой.
	float b_grit = band(28.0, texel);
	float b_pore = band(60.0, texel);
	// Деление на 0.75 — это нормировка: `fbm` на двух октавах даёт диапазон
	// [0, 0.75] со средним 0.375, а не [0, 1] со средним 0.5. Без неё
	// `(grit − 0.5)` почти всегда отрицательно, и вместо фактуры получается
	// ровное затемнение с еле заметным разбросом — поверхность снова гладкая.
	if (b_grit > 0.01) {
		float grit = fbm(rot * w * 14.0, 2) / 0.75;
		col *= 1.0 - (grit - 0.5) * 0.30 * b_grit;
		rough = mix(rough, 1.0, b_grit * 0.25);
	}
	if (b_pore > 0.01) {
		float pore = smoothstep(0.62, 0.88, fbm(rot * w * 30.0, 2) / 0.75);
		col *= 1.0 - pore * 0.28 * b_pore;
		hgt -= pore * 0.0030 * b_pore;
	}

	if (is_side) {
		float se = fbm(wpos.xy * 6.0, 2);
		col = col_b * (0.80 + se * 0.30);
		rough = 1.0;
		hgt = 0.0;
	}

	// Нормаль из того же поля высот, экранными производными (Mikkelsen).
	// Так не нужен ни тангентный базис BoxMesh, ни отдельная карта нормалей, а
	// шов, просевшая плита и выбоина начинают ЛОВИТЬ СВЕТ — без этого любая,
	// сколь угодно богатая процедурная раскраска остаётся крашеным картоном.
	// Затухает с расстоянием: на мелком масштабе экранные производные шумят.
	// Гасится с расстоянием и на скользящих углах: NORMAL во фрагменте —
	// видовая, её z и есть косинус угла к камере.
	float bs = bump * clamp(1.0 - dist / 70.0, 0.0, 1.0)
			* smoothstep(0.05, 0.28, abs(NORMAL.z));
	vec3 sx = dFdx(wpos);
	vec3 sy = dFdy(wpos);
	vec3 nw = n_world;
	vec3 r1 = cross(sy, nw);
	vec3 r2 = cross(nw, sx);
	float det = dot(sx, r1);
	float dn = abs(det);

	// `dn` — площадь пиксельного следа на поверхности, и она обращается в НОЛЬ
	// на целой линии в кадре (там, где экранные производные мировой позиции
	// становятся коллинеарны). В этой точке `sign(det)` тоже ноль, то есть и
	// градиент ноль, и `normalize(vec3(0))` даёт NaN — на земле это рисовало
	// аккуратную тонкую тёмную линию через весь кадр, ступеньками. MSAA её не
	// сглаживал: это затенение, а не кромка геометрии, и диагноз ставится
	// только выводом нормали цветом (чёрная линия = NaN).
	if (bs > 0.001 && dn > 1e-9) {
		vec3 g = bs * sign(det) * (dFdx(hgt) * r1 + dFdy(hgt) * r2) / dn;
		// Возмущение не должно превзойти саму нормаль: иначе на скользящих
		// участках она переворачивается и поверхность идёт белыми блёстками,
		// как солью. Потолок наклона микрорельефа — около 31°.
		float gl = length(g);
		if (gl > 0.6) {
			g *= 0.6 / gl;
		}
		NORMAL = normalize((VIEW_MATRIX * vec4(normalize(nw - g), 0.0)).xyz);
	}

	ALBEDO = col;
	ROUGHNESS = clamp(rough, 0.35, 1.0);
	METALLIC = 0.0;
	SPECULAR = 0.25;

	// Отладочный вывод внутрь шейдера — самый быстрый способ понять, что
	// именно неправильно, когда картинка «просто странная».
	if (debug == 1) {
		ALBEDO = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz)
				* 0.5 + 0.5;
		ROUGHNESS = 1.0;
	} else if (debug == 2) {
		ALBEDO = vec3(fract(hgt * 60.0 + 0.5));
		ROUGHNESS = 1.0;
	}
}
